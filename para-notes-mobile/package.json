{
  "name": "para-notes-mobile",
  "version": "1.0.0",
  "type": "module",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test": "jest --config jest.config.mobile.cjs",
    "test:watch": "jest --config jest.config.mobile.cjs --watch",
    "test:coverage": "jest --config jest.config.mobile.cjs --coverage",
    "test:ci": "jest --config jest.config.mobile.cjs --ci --coverage --watchAll=false",
    "test:unit": "jest --config jest.config.mobile.cjs --testPathPattern=unit",
    "test:integration": "jest --testPathPattern=integration",
    "test:component": "jest --testPathPattern=component",
    "test:e2e": "detox test",
    "test:e2e:build": "detox build",
    "test:security": "jest --testPathPattern=security",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:component",
    "lint": "eslint . --ext .ts,.tsx",
    "lint:fix": "eslint . --ext .ts,.tsx --fix",
    "type-check": "tsc --noEmit",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios"
  },
  "dependencies": {
    "@react-navigation/bottom-tabs": "^7.4.7",
    "@react-navigation/drawer": "^7.5.8",
    "@react-navigation/native": "^7.1.17",
    "@react-navigation/stack": "^7.4.8",
    "@supabase/supabase-js": "^2.57.4",
    "@tanstack/react-query": "^5.87.4",
    "crypto-js": "^4.2.0",
    "expo": "~54.0.1",
    "expo-camera": "^17.0.7",
    "expo-constants": "^18.0.8",
    "expo-crypto": "^15.0.6",
    "expo-image-picker": "^17.0.7",
    "expo-linking": "^8.0.7",
    "expo-secure-store": "^15.0.6",
    "expo-sharing": "^14.0.7",
    "expo-speech": "^14.0.6",
    "expo-sqlite": "^16.0.8",
    "expo-status-bar": "~3.0.7",
    "lunr": "^2.3.9",
    "nanoid": "^5.1.5",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-mmkv": "^3.3.1",
    "react-native-safe-area-context": "^5.6.1",
    "react-native-screens": "^4.16.0",
    "react-native-webview": "^13.16.0",
    "uuid": "^13.0.0",
    "valtio": "^2.1.7",
    "zod": "^4.1.7",
    "zustand": "^5.0.8",
    "react-dom": "19.1.0",
    "react-native-web": "^0.21.0",
    "@expo/metro-runtime": "~6.1.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.3",
    "@babel/preset-typescript": "^7.27.1",
    "@eslint/js": "^9.35.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@testing-library/jest-native": "^5.4.3",
    "@testing-library/react-native": "^13.3.3",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.1.0",
    "@types/react-native": "^0.72.8",
    "@typescript-eslint/eslint-plugin": "^8.43.0",
    "@typescript-eslint/parser": "^8.43.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-preset-expo": "^54.0.0",
    "detox": "^20.25.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^5.0.0",
    "jest": "^29.7.0",
    "jest-expo": "^54.0.10",
    "msw": "^2.6.8",
    "ts-jest": "^29.4.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
